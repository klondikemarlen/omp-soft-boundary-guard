{
  "name": "omp-soft-boundary-guard",
  "version": "2.1.5",
  "description": "OMP soft boundary guard with one-shot approval for recognized external GitHub writes and advisory warnings for other mutations.",
  "type": "module",
  "scripts": {
    "test": "bun test",
    "lint": "oxlint --deny-warnings .",
    "release:check": "bun run scripts/release-check.ts && bun run lint && bun node_modules/typescript/bin/tsc --noEmit && bun test",
    "handoff": "bun run bin/repository-mutation-handoff.ts",
    "reinstall": "bun run scripts/reinstall.ts"
  },
  "keywords": ["omp-plugin", "soft-boundary", "boundary-guard", "safety"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/klondikemarlen/omp-soft-boundary-guard.git"
  },
  "omp": {
    "extensions": ["./index.ts"]
  },
  "dependencies": {
    "@lezer/common": "^1.5.3",
    "@lezer/python": "^1.1.19",
    "shell-quote": "^1.10.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "oxlint": "1.93.0",
    "typescript": "^7.0.2"
  }
}
